repositories:
  BIG_BRAIN/src/micro_ros_setup:
    type: git
    url: https://github.com/micro-ROS/micro_ros_setup.git
    version: jazzy

  BIG_BRAIN/src/ros2_astra_camera:
    type: git
    url: https://github.com/rgruberski/ros2_astra_camera.git
    version: fix/astra-kilted-build

  BIG_BRAIN/src/sllidar_ros2:
    type: git
    url: https://github.com/Slamtec/sllidar_ros2.git
    version: main

  BIG_BRAIN/src/topic_based_ros2_control:
    type: git
    url: https://github.com/PickNikRobotics/topic_based_ros2_control.git
    version: main

  BIG_BRAIN/src/uros/micro-ROS-Agent:
    type: git
    url: https://github.com/micro-ROS/micro-ROS-Agent.git
    version: jazzy

  MICRO_ROS/micro_ros_stm32cubemx_utils:
    type: git
    url: https://github.com/micro-ROS/micro_ros_stm32cubemx_utils.git
    version: jazzy

  SMALL_BRAIN/vision_models/depthanything_tools/Depth-Anything-V2:
    type: git
    url: https://github.com/DepthAnything/Depth-Anything-V2.git
    version: main

  SMALL_BRAIN/vision_models/groundingdino_tools/GroundingDINO:
    type: git
    url: https://github.com/wenyi5608/GroundingDINO.git
    version: wenyi5608-openvino

  SMALL_BRAIN/vision_models/sam2_tools/sam2:
    type: git
    url: https://github.com/facebookresearch/sam2.git
    version: main
