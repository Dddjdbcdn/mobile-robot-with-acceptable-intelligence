<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <Sequence>

      <ControllerSelector selected_controller="{selected_controller}" default_controller="FollowPath" topic_name="controller_selector"/>
      <PlannerSelector selected_planner="{selected_planner}" default_planner="GridBased" topic_name="planner_selector"/>
      <RecoveryNode number_of_retries="1" name="ComputePath">
        <ComputePathToPose
          goal="{goal}"
          path="{path}"
          planner_id="{selected_planner}"
          error_code_id="{compute_path_error_code}"/>
        <Sequence>
          <WouldAPlannerRecoveryHelp error_code="{compute_path_error_code}"/>
          <ClearEntireCostmap name="ClearGlobalCostmap-Context" service_name="global_costmap/clear_entirely_global_costmap"/>
        </Sequence>
      </RecoveryNode>

      <RecoveryNode number_of_retries="1" name="NavigateRecovery">

        <PipelineSequence name="Navigate with DJ custom validators">

          <RateController hz="2.0">
            <Sequence>
              <GetCurrentPose current_pose="{robot_pose}"/>

              <DJGoalValidator
                goal="{goal}"
                robot_pose="{robot_pose}"
                patience="2"/>

              <Fallback>
                <DJPathValidator
                  goal="{goal}"
                  robot_pose="{robot_pose}"
                  path="{path}"
                  accepted_path="{accepted_path}"
                  patience="2"
                  max_corridors="5"
                  max_paths_per_corridors="5"
                  max_replans_per_segment="8"
                  segment_length="2.0"
                  max_deviation="0.5"
                  max_length_ratio="2.0"/>

                <RecoveryNode number_of_retries="1" name="ComputePath">
                  <ComputePathToPose
                    goal="{goal}"
                    path="{path}"
                    planner_id="{selected_planner}"
                    error_code_id="{compute_path_error_code}"/>
                  <Sequence>
                    <WouldAPlannerRecoveryHelp error_code="{compute_path_error_code}"/>
                    <ClearEntireCostmap name="ClearGlobalCostmap-Context" service_name="global_costmap/clear_entirely_global_costmap"/>
                  </Sequence>
                </RecoveryNode>
              </Fallback>
              
            </Sequence>
          </RateController>

          <RecoveryNode number_of_retries="1" name="FollowPath">
            <FollowPath 
              path="{accepted_path}" 
              controller_id="{selected_controller}" 
              error_code_id="{follow_path_error_code}" />
            <Sequence>
              <WouldAControllerRecoveryHelp error_code="{follow_path_error_code}"/>
              <ClearEntireCostmap name="ClearLocalCostmap-Context" service_name="local_costmap/clear_entirely_local_costmap"/>
            </Sequence>
          </RecoveryNode>

        </PipelineSequence>

        <Sequence>
          <ClearEntireCostmap name="ClearLocalBeforeBackup" service_name="local_costmap/clear_entirely_local_costmap"/>
          <BlindBackUp backup_dist="0.1" backup_speed="0.15"/>
        </Sequence>

      </RecoveryNode>
    </Sequence>
  </BehaviorTree>
</root>